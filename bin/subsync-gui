#!/usr/bin/env python3
"""Standalone launcher for SubSync Studio GUI (Hybrid Math + Local AI)."""

import os
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parent.parent
AI_ENV = REPO_ROOT / ".ai_env"
if AI_ENV.is_dir() and str(AI_ENV) not in sys.path:
    sys.path.insert(0, str(AI_ENV))
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from subsync.__main__ import subsync

if __name__ == "__main__":
    argv = [sys.argv[0], "gui"] + sys.argv[1:]
    sys.exit(subsync(argv))
